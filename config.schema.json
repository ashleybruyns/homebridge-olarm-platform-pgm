{
  "pluginAlias": "Olarm",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "For setup instructions, see the [README](https://github.com/ashleybruyns/homebridge-olarm-platform-pgm#readme).",
  "footerDisplay": "For help and support, please visit the [GitHub repository](https://github.com/ashleybruyns/homebridge-olarm-platform-pgm/issues). Forked from [homebridge-olarm-platform](https://github.com/vangogh27/homebridge-olarm-platform), created by Louis Germishuys.",
  "schema": {
    "type": "object",
    "properties": {
      "platform": {
        "title": "Platform",
        "type": "string",
        "const": "Olarm",
        "description": "Must be 'Olarm' - do not change"
      },
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Olarm",
        "required": true
      },
      "deviceId": {
        "title": "Device ID",
        "type": "string",
        "required": true,
        "description": "Your Olarm device ID"
      },
      "deviceName": {
        "title": "Device Name",
        "type": "string",
        "default": "Olarm Security",
        "description": "The name displayed in HomeKit for the security system"
      },
      "apiKey": {
        "title": "API Key",
        "type": "string",
        "required": true,
        "description": "Generate one in the Olarm user portal (https://user.olarm.com) under API access"
      },
      "mqttClientIdSuffix": {
        "title": "MQTT Client ID Suffix",
        "type": "string",
        "placeholder": "8",
        "description": "Must differ from any other Olarm integration (e.g. Home Assistant) connected with the same account. Default: 8"
      },
      "includedZones": {
        "title": "Included Zones",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "number",
          "title": "Zone Number"
        },
        "description": "List of zone numbers to include (leave empty for all zones)"
      },
      "addBypassSwitches": {
        "title": "Add Bypass Switches",
        "type": "boolean",
        "default": false,
        "description": "Add switches to bypass individual zones"
      },
      "pollingInterval": {
        "title": "Polling Interval (seconds)",
        "type": "integer",
        "default": 300,
        "minimum": 30,
        "description": "How often to poll for updates when MQTT is unavailable"
      },
      "automations": {
        "title": "Automations",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "ID",
              "type": "string",
              "description": "Unique identifier for this automation (optional)"
            },
            "name": {
              "title": "Name",
              "type": "string",
              "description": "Name displayed in HomeKit"
            },
            "zones": {
              "title": "Zones to Bypass",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "number",
                "title": "Zone Number"
              },
              "description": "List of zone numbers to bypass before arming"
            },
            "armMode": {
              "title": "Arm Mode",
              "type": "string",
              "oneOf": [
                { "title": "Away", "enum": ["arm"] },
                { "title": "Stay", "enum": ["stay"] },
                { "title": "Night", "enum": ["sleep"] }
              ],
              "description": "Which arm mode to activate after bypassing zones"
            }
          }
        }
      },
      "gates": {
        "title": "Gates",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "ID",
              "type": "string",
              "description": "Unique identifier for this gate (optional; defaults to the zone and PGM numbers)"
            },
            "name": {
              "title": "Name",
              "type": "string",
              "required": true,
              "description": "Name displayed in HomeKit (e.g. 'Driveway Gate')"
            },
            "zone": {
              "title": "Zone Number",
              "type": "integer",
              "minimum": 1,
              "required": true,
              "description": "Olarm zone number whose sensor is closed only when the gate is fully closed"
            },
            "pgm": {
              "title": "PGM Number",
              "type": "integer",
              "minimum": 1,
              "required": true,
              "description": "Olarm PGM number that is pulsed to trigger the gate motor (must be enabled with pulse control on the panel)"
            },
            "operationTime": {
              "title": "Operation Time (seconds)",
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "description": "How long the gate takes to fully open or close. Further open/close requests are blocked for this long after each pulse."
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "platform",
      "type": "hidden"
    },
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "name",
        "deviceId",
        "deviceName"
      ]
    },
    {
      "type": "fieldset",
      "title": "Authentication",
      "expandable": false,
      "items": [
        "apiKey"
      ]
    },
    {
      "type": "fieldset",
      "title": "Connection",
      "expandable": true,
      "expanded": false,
      "items": [
        "pollingInterval",
        "mqttClientIdSuffix"
      ]
    },
    {
      "type": "fieldset",
      "title": "Zone Configuration",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "includedZones",
          "type": "array",
          "title": "Included Zones",
          "description": "Add zone numbers to include (leave empty for all zones)",
          "items": [
            {
              "type": "number",
              "placeholder": "Enter zone number (e.g. 1, 2, 3)"
            }
          ]
        },
        "addBypassSwitches"
      ]
    },
    {
      "type": "fieldset",
      "title": "Automations",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "automations",
          "type": "array",
          "title": "{{ value.name || 'New Automation' }}",
          "items": [
            "automations[].id",
            "automations[].name",
            "automations[].zones",
            "automations[].armMode"
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Gates",
      "expandable": true,
      "expanded": false,
      "description": "Combines an Olarm zone (open/closed state) with a PGM (pulsed to trigger the gate motor) as a HomeKit Garage Door. The PGM must be enabled and allow pulse control on the panel.",
      "items": [
        {
          "key": "gates",
          "type": "array",
          "title": "{{ value.name || 'New Gate' }}",
          "items": [
            "gates[].id",
            "gates[].name",
            "gates[].zone",
            "gates[].pgm",
            "gates[].operationTime"
          ]
        }
      ]
    }
  ]
}