{
  "name": "homebridge-olarm-platform-pgm",
  "displayName": "Olarm Security System (Gates & PGM)",
  "type": "module",
  "version": "2.0.0",
  "description": "Homebridge plugin for Olarm security systems using the official Olarm API, with real-time MQTT updates, zone discovery and gate control via PGM outputs.",
  "author": "Louis Germishuys",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ashleybruyns/homebridge-olarm-platform-pgm#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashleybruyns/homebridge-olarm-platform-pgm.git"
  },
  "bugs": {
    "url": "https://github.com/ashleybruyns/homebridge-olarm-platform-pgm/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "olarm",
    "security-system",
    "alarm",
    "mqtt",
    "smart-home",
    "homekit",
    "gate",
    "garage-door",
    "pgm"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "mqtt": "^5.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.36.0",
    "homebridge": "^2.0.0-beta.30",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
